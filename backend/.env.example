# ============================================
# VERCEL DEPLOYMENT - Environment Variables
# Import this file in Vercel Dashboard
# ============================================

# Database (PostgreSQL - Required for Vercel)
# Get this from Vercel Postgres, Neon, or any PostgreSQL provider
POSTGRES_URL=postgres://username:password@host:5432/database

# Authentication
JWT_SECRET=your_super_secret_jwt_key_2024_placement_portal

# Environment
NODE_ENV=production

# Server Port
PORT=5000

# Development (Local only - not needed on Vercel)
DB_STORAGE=./database.sqlite