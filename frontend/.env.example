# Vercel Environment Variables
# Import these in Vercel Dashboard → Settings → Environment Variables

# Database (PostgreSQL for Vercel)
POSTGRES_URL=your_postgres_connection_string_here

# Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# Environment
NODE_ENV=production

# Server
PORT=5000

# Frontend (Vercel will set these automatically)
# VITE_API_URL=/api